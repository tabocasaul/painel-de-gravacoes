 namespace android {
 
+namespace {
+
+// The vendor camera domain can read this path without granting it access to
+// /data.  A Magisk overlay supplies the file at runtime.  The file contains
+// consecutive 640x360 I420 frames generated by instalar-videocam.ps1.
+constexpr char kVideoFramePath[] = "/vendor/etc/config/emu_camera_video.i420";
+constexpr char kVideoControlPath[] = "/vendor/etc/config/emu_camera_control.txt";
+constexpr uint32_t kVideoFrameWidth = 640;
+constexpr uint32_t kVideoFrameHeight = 360;
+
+bool ReadVideoI420Frame(YCbCrPlanes* planes, size_t* width,
+                        size_t* height) {
+  static std::mutex clock_mutex;
+  static VideoPlaybackClock clock;
+  static uint64_t generation = 0;
+  uint64_t absolute_frame;
+  uint64_t current_generation;
+  {
+    std::lock_guard<std::mutex> lock(clock_mutex);
+    static bool paused = true;
+    std::ifstream control(kVideoControlPath);
+    std::string state;
+    uint64_t requested_generation = generation;
+    if (control >> state >> requested_generation) paused = state == "pause";
+    generation = requested_generation;
+    current_generation = generation;
+    const auto now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    absolute_frame = clock.Frame(now, paused, generation);
+  }
+
+  // Each processing thread owns its pixels until scaling finishes. All outputs
+  // select their position from the same clock, rather than consuming frames.
+  thread_local std::ifstream source;
+  thread_local std::vector<uint8_t> frame;
+  thread_local uint64_t source_generation = UINT64_MAX;
+  thread_local uint64_t loaded_frame = UINT64_MAX;
+  thread_local uint64_t frame_count = 0;
+  const size_t frame_size = kVideoFrameWidth * kVideoFrameHeight * 3 / 2;
+  if (source_generation != current_generation || !source.is_open()) {
+    source.close();
+    source.clear();
+    source.open(kVideoFramePath, std::ios::binary);
+    if (!source.is_open()) return false;
+    source.seekg(0, std::ios::end);
+    const auto bytes = source.tellg();
+    if (bytes < static_cast<std::streamoff>(frame_size)) { source.close(); return false; }
+    frame_count = static_cast<uint64_t>(bytes) / frame_size;
+    source_generation = current_generation;
+    loaded_frame = UINT64_MAX;
+    frame.resize(frame_size);
+  }
+  const uint64_t selected_frame = absolute_frame % frame_count;
+  if (selected_frame != loaded_frame) {
+    source.clear();
+    source.seekg(static_cast<std::streamoff>(selected_frame * frame_size), std::ios::beg);
+    source.read(reinterpret_cast<char*>(frame.data()), frame_size);
+    if (source.gcount() != static_cast<std::streamsize>(frame_size)) return false;
+    loaded_frame = selected_frame;
+  }
+
+  *planes = {
+      .img_y = frame.data(),
+      .img_cb = frame.data() + kVideoFrameWidth * kVideoFrameHeight,
+      .img_cr = frame.data() + kVideoFrameWidth * kVideoFrameHeight * 5 / 4,
+      .y_stride = kVideoFrameWidth,
+      .cbcr_stride = kVideoFrameWidth / 2,
+      .cbcr_step = 1};
+  *width = kVideoFrameWidth;
+  *height = kVideoFrameHeight;
+  return true;
+}
+
+}  // namespace
